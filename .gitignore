# Local .terraform directories (downloaded providers/modules)
**/.terraform/*

# Terraform state files
*.tfstate
*.tfstate.*

# Crash log files
crash.log
crash.*.log

# Plan output files
*.tfplan
tfplan

# Variable files that may contain secrets
*.tfvars
*.tfvars.json
!example.tfvars

# CLI config
.terraformrc
terraform.rc

# Override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Keep the dependency lock file (.terraform.lock.hcl) tracked
